  "npm:react-dom" [fillcolor=white];
  "npm:tailwindcss" [fillcolor=white];
  "npm:three" [fillcolor=white];
  "npm:ws" [fillcolor=white];

  "scripts/emit-test-events.mjs" -> "npm:ws";
