digraph untangled {
  graph [layout=dot, rankdir=LR, fontname="Helvetica"];
  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [color="#898781"];

  "." [label=".\n1 file"];
  "src/domain" [label="src/domain\n2 files", color="#d03b3b", penwidth=2];
  "src/http" [label="src/http\n2 files"];
  "src/infra" [label="src/infra\n2 files", color="#d03b3b", penwidth=2];

  "." -> "src/http";
  "src/domain" -> "src/infra" [color="#d03b3b", penwidth=2];
  "src/http" -> "src/domain";
  "src/http" -> "src/infra";
  "src/infra" -> "src/domain" [color="#d03b3b", penwidth=2];
}
