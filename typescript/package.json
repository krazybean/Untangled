{
  "name": "@krazybean/untangled",
  "version": "1.0.1",
  "description": "Dependency health your whole team can understand: cycles, coupling and trends for JavaScript and TypeScript.",
  "license": "MIT",
  "author": "Juan Castro",
  "keywords": [
    "dependency-graph",
    "code-dependencies",
    "circular-dependencies",
    "import-graph",
    "module-dependencies",
    "coupling",
    "architecture",
    "static-analysis",
    "code-visualization",
    "dependency-health",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/krazybean/Untangled/blob/main/typescript/README.md",
  "bugs": "https://github.com/krazybean/Untangled/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krazybean/Untangled.git",
    "directory": "typescript"
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "untangled": "bin/untangled.js",
    "utg": "bin/untangled.js"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
